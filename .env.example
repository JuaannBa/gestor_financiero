# Copy to .env and fill in. Never commit .env.

# Django
DEBUG=True
SECRET_KEY=change-me-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by docker-compose and dj-database-url)
POSTGRES_DB=gestor_financiero
POSTGRES_USER=gestor
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://gestor:change-me@localhost:5432/gestor_financiero

# CORS (dev only — frontend served by Vite on another port)
CORS_ALLOWED_ORIGINS=http://localhost:5173
